{
	"nodes":[
		{"id":"205c9baab162673a","type":"text","text":"```mermaid \n%%{init: {\"themeVariables\": {\"fontSize\": \"8px\"}, \"flowchart\": {\"nodeSpacing\": 10, \"rankSpacing\": 15}} }%%\nflowchart TD\n    A[\"用户输入任务<br/>例如：帮我写入 test.txt\"] --> B[\"Agent 推理<br/>决定调用工具\"]\n\n    B --> C[\"renderer.resetBetweenIterations()<br/>工具调用前刷新流式输出缓冲<br/>避免审批框插到半行文本中\"]\n\n    C --> D[\"toolRegistry.executeTool(toolName, argumentsJson)<br/>Agent 发起工具调用\"]\n\n    D --> E[\"HitlToolRegistry.executeTool(name, argumentsJson)<br/>HITL 拦截层入口\"]\n\n    E --> F{\"hitlHandler.isEnabled()<br/>判断 HITL 是否开启\"}\n\n    F -- \"否\" --> G[\"super.executeTool(name, argumentsJson)<br/>HITL 关闭，直接执行原工具\"]\n\n    F -- \"是\" --> H{\"ApprovalPolicy.requiresApproval(name)<br/>判断该工具是否需要审批\"}\n\n    H -- \"否\" --> I[\"super.executeTool(name, argumentsJson)<br/>安全工具，直接执行<br/>如 read_file / list_dir / search_code\"]\n\n    H -- \"是\" --> J[\"ApprovalRequest.of(name, argumentsJson, null)<br/>构造审批请求对象\"]\n\n    J --> K[\"ApprovalPolicy.getDangerLevel(name)<br/>生成风险等级<br/>如 高危 / 中危 / 安全\"]\n\n    J --> L[\"ApprovalPolicy.getRiskDescription(name)<br/>生成风险说明<br/>告诉用户这个工具危险在哪里\"]\n\n    K --> M[\"ApprovalRequest<br/>保存工具名、参数、风险等级、风险说明、建议等信息\"]\n    L --> M\n\n    M --> N[\"hitlHandler.requestApproval(request)<br/>发起人工审批\"]\n\n    N --> O[\"TerminalHitlHandler.requestApproval(request)<br/>终端审批实现<br/>synchronized 保证并发时一次只弹一个审批框\"]\n\n    O --> P{\"approvedAllTools.contains(request.toolName())<br/>该工具本次会话是否已全部放行\"}\n\n    P -- \"是\" --> Q[\"ApprovalResult.approveAll()<br/>自动通过，不再询问用户\"]\n\n    P -- \"否\" --> R[\"request.toDisplayText()<br/>格式化审批信息<br/>展示工具名、参数、风险等级、风险说明\"]\n\n    R --> S[\"displayWidth(text)<br/>计算终端显示宽度<br/>中文 / 全角 / emoji 按 2 列处理<br/>保证审批框对齐\"]\n\n    S --> T[\"promptUntilDecision(request)<br/>等待用户输入决策\"]\n\n    T --> U{\"用户输入\"}\n\n    U -- \"y 或回车\" --> V[\"ApprovalResult.approve()<br/>批准，使用原始参数执行\"]\n\n    U -- \"a\" --> W[\"ApprovalResult.approveAll()<br/>批准，并把当前 toolName 加入全部放行集合\"]\n\n    U -- \"n\" --> X[\"ApprovalResult.reject(reason)<br/>拒绝，并记录拒绝原因\"]\n\n    U -- \"s\" --> Y[\"ApprovalResult.skip()<br/>跳过当前工具调用\"]\n\n    U -- \"m\" --> Z[\"ApprovalResult.modify(modifiedArguments)<br/>修改参数后批准执行\"]\n\n    U -- \"连续 5 次无效输入\" --> X\n\n    Q --> AA[\"回到 HitlToolRegistry<br/>处理 ApprovalResult\"]\n    V --> AA\n    W --> AA\n    X --> AA\n    Y --> AA\n    Z --> AA\n\n    AA --> AB{\"result.isRejected()<br/>是否被拒绝\"}\n\n    AB -- \"是\" --> AC[\"返回字符串给 Agent<br/>[HITL] 操作已被拒绝：reason<br/>Agent 可根据原因重新规划\"]\n\n    AB -- \"否\" --> AD{\"result.isSkipped()<br/>是否跳过\"}\n\n    AD -- \"是\" --> AE[\"返回字符串给 Agent<br/>[HITL] 操作已被跳过\"]\n\n    AD -- \"否\" --> AF[\"result.effectiveArguments(argumentsJson)<br/>决定最终执行参数\"]\n\n    AF --> AG{\"decision == MODIFIED<br/>且 modifiedArguments 不为空\"}\n\n    AG -- \"是\" --> AH[\"使用 modifiedArguments<br/>用户修改后的参数\"]\n\n    AG -- \"否\" --> AI[\"使用 argumentsJson<br/>Agent 原始参数\"]\n\n    AH --> AJ[\"super.executeTool(name, effectiveArgs)<br/>真正执行工具\"]\n    AI --> AJ\n\n    G --> AK[\"返回工具执行结果给 Agent\"]\n    I --> AK\n    AJ --> AK\n    AC --> AK\n    AE --> AK\n\n    AK --> AL[\"Agent 接收工具结果<br/>继续回复、重新规划或结束任务\"]\n```","x":-400,"y":-260,"width":760,"height":500}
	],
	"edges":[]
}